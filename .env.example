# Supabase — use apenas chaves públicas no front (Vite).
# Nunca commite .env com segredos. Não use service_role no browser.

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Mesmo valor da chave anon pública (nome alternativo aceito pelo app):
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Opcional: referência ao projeto (logs, suporte); não substitui URL nem chave.
VITE_SUPABASE_PROJECT_ID=

# Mercado Pago — chave pública (Checkout Bricks / futuro uso no browser). Não coloque access token aqui.
VITE_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Edge Functions (Secrets no Dashboard ou `npx supabase secrets set`):
# MERCADO_PAGO_ACCESS_TOKEN — credencial de produção ou teste
# MERCADO_PAGO_WEBHOOK_SECRET — opcional; validação adicional de assinatura de webhook
# ALLOWED_APP_ORIGINS — Secret na Edge Function create-mercado-pago-preference (não no .env do Vite).
# Domínios do app sem barra final, separados por vírgula. Ex. Lovable + produção futura:
#   https://jmbeautyflow.lovable.app,https://app.seudominio.com
# Localhost (http) é aceito automaticamente para desenvolvimento.
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY costumam ser injetados pelo host.
# Webhook MP: https://<ref>.supabase.co/functions/v1/mercado-pago-webhook
