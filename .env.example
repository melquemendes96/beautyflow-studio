# =============================================================================
# BeautyFlow Studio — variáveis de ambiente (.env na raiz do repositório)
# Nunca commite .env com segredos. Não use service_role nem access_token no Vite.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vite) — lidas em build e em dev; expostas no bundle do browser
# -----------------------------------------------------------------------------
# Obrigatórias para o app funcionar:
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# OBRIGATÓRIO para REST/RLS (JWT que começa com eyJ...):
# Supabase Dashboard → Settings → API → Legacy API Keys → anon
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# NÃO use VITE_SUPABASE_PUBLISHABLE_KEY (sb_publishable_) — o Vite embute no bundle e causa 401.

# Opcional — referência ao projeto (logs, suporte); não substitui URL nem chave:
# VITE_SUPABASE_PROJECT_ID=

# Opcional — fallback de navegação master (separados por vírgula)
# VITE_PLATFORM_MASTER_EMAILS=seu@email.com

# Opcional — URL pública do site (redirect OAuth em SSR)
# VITE_SITE_URL=https://jmbeautyflow.tech

# Supabase Dashboard → Authentication → URL Configuration:
# Site URL: https://jmbeautyflow.tech
# Redirect URLs: http://localhost:8080/auth/callback
#   http://localhost:5173/auth/callback
#   https://jmbeautyflow.tech/auth/callback

# Opcional — Mercado Pago (público; Checkout Pro atual usa Edge Function, não exige no fluxo atual):
# VITE_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Servidor Node (VPS / PM2) — usadas por `srvx` em `npm run start`
# -----------------------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production

# -----------------------------------------------------------------------------
# Supabase Edge Functions — configure em: Dashboard → Edge Functions → Secrets
# ou: npx supabase secrets set NOME=valor
#
# create-mercado-pago-preference + mercado-pago-webhook:
#   MERCADO_PAGO_ACCESS_TOKEN
#   Produção (cobrança real): APP_USR-... → checkout usa init_point
#   Teste local/sandbox: TEST-... → checkout usa sandbox_init_point (não use TEST- com ALLOWED_APP_ORIGINS de produção)
#   ALLOWED_APP_ORIGINS   (ex.: https://app.seudominio.com — sem barra final; vários separados por vírgula)
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY (geralmente injetados)
#
# mercado-pago-webhook:
#   MERCADO_PAGO_ACCESS_TOKEN
#   MERCADO_PAGO_WEBHOOK_SECRET   (recomendado em produção — validação x-signature)
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#
# meta-whatsapp-webhook:
#   META_APP_SECRET               (recomendado — valida X-Hub-Signature-256 em POST)
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#
# Webhook MP (URL fixa no Supabase):
#   https://<ref>.supabase.co/functions/v1/mercado-pago-webhook
#
# Webhook Meta (inclua ?company_id=<uuid> ao cadastrar no painel Meta):
#   https://<ref>.supabase.co/functions/v1/meta-whatsapp-webhook?company_id=<UUID>
# -----------------------------------------------------------------------------
